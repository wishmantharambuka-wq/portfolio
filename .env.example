# Copy to .env.local (gitignored) and fill in. All are OPTIONAL.
# Restart the dev server after changing anything here.

# ---------------------------------------------------------------------------
# Admin panel
# ---------------------------------------------------------------------------
# The panel is available in `npm run dev` automatically. It is NOT included in
# production builds unless you set this to true.
#
# Think before enabling it on the live site: a password checked in the browser
# is deterrence, not protection (see src/lib/adminAuth.ts). You do not need it
# there — content is authored locally and published by pushing.
# VITE_ENABLE_ADMIN=true

# Username (defaults to "admin").
# VITE_ADMIN_USER=chamod

# Password hash. Generate with:  npm run set-admin-password
# That writes these two lines into .env.local for you. Until then the build
# falls back to the shipped default (admin / admin123) and the login screen
# warns you about it.
# VITE_ADMIN_PW_SALT=
# VITE_ADMIN_PW_HASH=

# ---------------------------------------------------------------------------
# Site URL (Open Graph share previews)
# ---------------------------------------------------------------------------
# Auto-detected on Vercel. Set this only for a custom domain.
# VITE_SITE_URL=https://your-domain.com

# ---------------------------------------------------------------------------
# Base path
# ---------------------------------------------------------------------------
# Only for GitHub Pages project sites; the workflow sets it automatically.
# VITE_BASE=/portfolio/
